# === Modele de configuration ===
# Copiez ce fichier en .env puis remplacez les valeurs :
#   cp .env.example .env
# Le fichier .env contient les vrais secrets et n'est PAS versionne.

# Base de donnees PostgreSQL
DB_NAME=odoo18
DB_USER=odoo
DB_PASSWORD=changez_moi

# Mot de passe maitre Odoo (gestionnaire de bases de donnees)
ADMIN_PASSWD=changez_moi
